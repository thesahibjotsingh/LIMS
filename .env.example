# Copy this file to .env.local for local development (git-ignored — see .gitignore).
# In production, set the same two variables in the Cloudflare Pages dashboard under
# Settings > Environment variables, for both the Production and Preview environments.

# Resend API key. Sign up at resend.com (free tier, no card required), then
# Dashboard > API Keys > Create API Key. Starts with "re_".
RESEND_API_KEY=

# The inbox that should receive "Request a call back" submissions from
# app/api/request-callback/route.ts.
CALLBACK_NOTIFY_EMAIL=

# Until limshisar.com is verified as a sending domain in Resend (Dashboard > Domains >
# Add Domain, then add the DNS records Resend gives you), the route sends from Resend's
# shared onboarding@resend.dev address. In that unverified state Resend will only
# deliver mail to the email address on the Resend account itself — so
# CALLBACK_NOTIFY_EMAIL must be that same address for a local/staging test to actually
# arrive. Once the domain is verified, update the `from` address in
# app/api/request-callback/route.ts to a limshisar.com address and CALLBACK_NOTIFY_EMAIL
# can point anywhere.
